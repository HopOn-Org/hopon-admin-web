{
  "clientId": "hopon-admin-web",
  "name": "HopOn Admin Web",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": true,
  "bearerOnly": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "authorizationServicesEnabled": false,
  "rootUrl": "https://hopon-admin-web.vercel.app",
  "baseUrl": "https://hopon-admin-web.vercel.app/",
  "redirectUris": ["https://hopon-admin-web.vercel.app/*"],
  "webOrigins": ["https://hopon-admin-web.vercel.app"],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://hopon-admin-web.vercel.app"
  },
  "defaultClientScopes": ["web-origins", "roles", "profile", "email"]
}
